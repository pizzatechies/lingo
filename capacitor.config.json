{
  "appId": "ke.lugha.app",
  "appName": "Lugha Zetu",
  "webDir": "dist/client",
  "android": {
    "backgroundColor": "#FFF8F0"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#FFF8F0"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#FFF8F0",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": false,
      "splashImmersive": false
    }
  }
}
